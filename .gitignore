.DS_Store
__pycache__/
*.pyc
node_modules/

# Shallow clones of upstream repos are evidence, not content; research/README.md says how to re-clone.
raw/repos/*

# Local render output from skill scripts
.design/
*.shot.png

# Playwright / smoke-test output
test-results/
smoke-report.json

# evolve run log and status (local)
feedback/evolve.log
feedback/evolve.status

# Per-user Claude Code permissions (the repo's .claude/skills/ is content and stays tracked)
.claude/settings.local.json

# Eval renders are reproducible from out/ with evals/render.mjs; keep runs lean
evals/runs/**/*.png
